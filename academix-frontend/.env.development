# URL de l'API (doit se terminer par /api).
#  - Dev : "/api" -> passe par le proxy CRA (package.json "proxy") => même origine, cookies OK
#  - Réseau fermé : ex. "https://academix-api.intranet:8007/api" (ou "/api" derrière un reverse proxy)
REACT_APP_API_BASE_URL=/api

# Base des liens directs vers les fichiers S3/MinIO : ${S3_BASE_URL}/${bucket}/${key}
REACT_APP_S3_BASE_URL=http://localhost:9000
REACT_APP_S3_BUCKET=academix

# Optionnel (réseau fermé) : service photo des utilisateurs (?username=... est ajouté)
REACT_APP_PHOTO_API_URL=
# Optionnel (réseau fermé) : lien du chat ouvert depuis la barre du haut
REACT_APP_CHAT_URL=
