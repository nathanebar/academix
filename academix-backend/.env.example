# ---------- Serveur ----------
PORT=8007
NODE_ENV=development
# HTTPS=true -> serveur https avec le certificat .pfx (réseau fermé)
HTTPS=false
CERT_PATH=certificate/cert.pfx
# Passphrase du .pfx
PASSWORD=
# Origines autorisées (séparées par des virgules). Vide si le front passe par un proxy même-origine.
CORS_ORIGINS=http://localhost:3000

# ---------- Authentification ----------
# local : login username/password (hors réseau)   |   ntlm : Windows/AD (réseau fermé)
AUTH_MODE=local
JWT_SECRET=change-me-with-a-long-random-string
# true -> toutes les routes /api (sauf /api/auth) exigent un JWT valide
REQUIRE_AUTH=false
# NTLM (AUTH_MODE=ntlm)
NTLM_DOMAIN=
# ex: ldap://dc1.domain.local,ldap://dc2.domain.local
NTLM_DOMAIN_CONTROLLER=
NTLM_DEBUG=false
# Compte admin créé par `npm run db:seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ---------- Base de données ----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=academix_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# ---------- Stockage S3 / MinIO ----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=academix
# Optionnel (ex: STANDARD_IA sur le réseau fermé si le stockage le supporte)
S3_STORAGE_CLASS=

# ---------- Divers ----------
# Chemin du binaire ffmpeg (sinon @ffmpeg-installer)
FFMPEG_PATH=
# API annuaire interne (recherche de personnes / photos) - optionnel
PEOPLE_API_URL=
PEOPLE_API_COOKIE=
