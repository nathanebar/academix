# ---------- Serveur ----------
PORT=8007
NODE_ENV=development
# HTTPS=true -> serveur https avec le certificat .pfx (réseau fermé)
HTTPS=false
CERT_PATH=certificate/cert.pfx
# Passphrase du .pfx
PASSWORD=
# Origines autorisées (séparées par des virgules). Vide si le front passe par un proxy même-origine.
# Sert aussi à autoriser l'affichage des fichiers de l'API dans une iframe du front (CSP frame-ancestors).
CORS_ORIGINS=http://localhost:3000
# Derrière un reverse proxy (nginx, IIS...) : nombre de proxys devant l'API (ex. 1), pour que l'IP du client
# soit lue dans X-Forwarded-For (limite de tentatives de connexion, logs). Vide = pas de proxy.
TRUST_PROXY=

# ---------- Authentification ----------
# local : login username/password (hors réseau)   |   ntlm : Windows/AD (réseau fermé)
AUTH_MODE=local
JWT_SECRET=change-me-with-a-long-random-string
# Durée de la session (JWT + cookies) : ex. 12h, 30m, 7d
JWT_EXPIRES_IN=12h
# true -> toutes les routes /api (sauf /api/auth) exigent un JWT valide, sinon 401 { "error": "unauthenticated" }.
# false (défaut pendant la migration #13) -> avec un token valide l'identité vient du token
# (X-User-Id ignoré) ; sans token l'ancien comportement par en-têtes fonctionne encore.
REQUIRE_AUTH=false
# NTLM (AUTH_MODE=ntlm)
NTLM_DOMAIN=
# ex: ldap://dc1.domain.local,ldap://dc2.domain.local
NTLM_DOMAIN_CONTROLLER=
NTLM_DEBUG=false
# Limite de tentatives de connexion (AUTH_MODE=local) : N échecs par IP + nom d'utilisateur en M minutes -> 429
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15
# Compte admin créé par `npm run db:seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ---------- Base de données ----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=academix_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false
# Pool de connexions (défauts : max 20, min 2). max × nombre de processus Node < max_connections de PostgreSQL (100 par défaut)
DB_POOL_MAX=20
DB_POOL_MIN=2
# Attente max d'une connexion libre / durée avant de fermer une connexion inutilisée (ms)
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# ---------- Stockage S3 / MinIO ----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=academix
# Optionnel (ex: STANDARD_IA sur le réseau fermé si le stockage le supporte)
S3_STORAGE_CLASS=

# ---------- Upload de fichiers ----------
# Taille max d'un fichier uploadé, en Mo (au-delà : 413)
UPLOAD_MAX_FILE_SIZE_MB=2048
# Dossier temporaire des uploads en cours (défaut : <tmp système>/academix-uploads). Doit avoir assez d'espace libre.
UPLOAD_TMP_DIR=
# Extensions refusées (415), séparées par des virgules. Vide = aucune. Défaut si la variable est absente :
# exe,msi,bat,cmd,com,scr,pif,ps1,vbs,vbe,wsf,jar,dll,sh,js,mjs,html,htm,xhtml,shtml,hta
# UPLOAD_BLOCKED_EXTENSIONS=

# ---------- Logs ----------
# Niveau minimum : error | warn | info | debug (défaut : info en production, debug sinon)
LOG_LEVEL=
# Dossier des logs (défaut : academix-backend/logs). Un fichier par niveau et par jour.
LOG_DIR=
# Les fichiers plus vieux que N jours sont supprimés (0 = tout garder)
LOG_RETENTION_DAYS=30
# true -> enregistre le body des requêtes en erreur (champs sensibles masqués, tronqué).
# false (défaut) -> seulement la liste des champs : pas de données personnelles dans les logs
LOG_REQUEST_BODY=false

# ---------- Divers ----------
# Chemin du binaire ffmpeg (sinon @ffmpeg-installer)
FFMPEG_PATH=
# API annuaire interne (recherche de personnes / photos) - optionnel
PEOPLE_API_URL=
PEOPLE_API_COOKIE=
# Le certificat HTTPS de l'annuaire est vérifié. S'il est signé par une autorité interne :
# chemin du certificat de l'autorité (PEM), recommandé
PEOPLE_API_CA_FILE=
# true -> NE PAS vérifier le certificat (ancien comportement, rejectUnauthorized: false).
# Seulement en dernier recours, si le certificat de l'autorité ne peut pas être fourni.
PEOPLE_API_INSECURE_TLS=false
# Délai max d'une requête vers l'annuaire (ms)
PEOPLE_API_TIMEOUT_MS=15000
